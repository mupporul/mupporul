# Mupporul Backend Configuration

# Port for Render.com / local Node server (Render assigns PORT automatically)
PORT=5000
NODE_ENV=development

# Supabase backend connection (leave unset to use the local JSON database).
# Obtain the Project URL and service_role key from Supabase > Project Settings > API.
# Keep the service_role key only in this backend environment; never put it in frontend variables.
# SUPABASE_URL=https://your-project-ref.supabase.co
# SUPABASE_SERVICE_ROLE_KEY=your-server-side-service-role-key
# SUPABASE_STORAGE_BUCKET=temple-images
