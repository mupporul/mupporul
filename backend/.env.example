# Mupporul Backend Configuration (100% Free Tier)

# Port for Render.com / Local Node server (Render assigns PORT automatically)
PORT=5000
NODE_ENV=development

# Allowed Frontend Origins (Comma separated for CORS)
# Add your GitHub Pages URL e.g. https://<username>.github.io or * for all
FRONTEND_URL=http://localhost:3000,http://localhost:5173

# DATABASE CONFIGURATION
# 1. OPTION A (Zero-config, Default): Built-in persistent file database (data/mupporul_db.json)
# Requires NO setup, completely free on any machine or Render disk.

# 2. OPTION B (Supabase PostgreSQL Free Tier):
# To connect to free Supabase PostgreSQL, paste your Connection String below:
# DATABASE_URL=postgresql://postgres.yourproject:yourpassword@aws-0-us-east-1.pooler.supabase.com:6543/postgres?sslmode=require

# 3. OPTION C (Admin Secret Key for secured operations)
ADMIN_SECRET=mupporul_admin_secret_key_2026
